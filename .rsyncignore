SECURITY.md
# CHANGELOG.md wird von der Update-Seite gelesen und bleibt daher dabei.
OPEN_TERMINAL_API_KEY
WEBUI_SECRET_KEY
config/config.php
# Der „at rest"-Schlüssel gehört auf den Zielserver, nicht ins Deployment –
# jede Instanz erzeugt beim ersten Start ihren eigenen.
storage/app.key
storage/tmp/*
!storage/tmp/.gitkeep
!storage/tmp/.htaccess
# Galerie-Medien bleiben auf dem Server – nie vom lokalen Stand überschreiben
# oder mit --delete entfernen. Eigene Sicherung nötig (nicht im ZIP-Backup).
storage/media/*
!storage/media/.gitkeep
!storage/media/.htaccess
# Dokumente bleiben ebenso auf dem Server – gleiche Begründung wie bei den
# Galerie-Medien (eigene Sicherung, nicht im ZIP-Backup).
storage/documents/*
!storage/documents/.gitkeep
!storage/documents/.htaccess
storage/backups/*
!storage/backups/.gitkeep
!storage/backups/.htaccess
public/assets/uploads/*
!public/assets/uploads/.gitkeep
!public/assets/uploads/.htaccess
scripts/deploy.env
