/\.DS_Store
**/.DS_Store
/config/config.php

# Lokale Tool-Artefakte, gehören nicht ins Repo und nicht auf den Server
/OPEN_TERMINAL_API_KEY
/WEBUI_SECRET_KEY
/vendor/
/public/assets/uploads/*
!/public/assets/uploads/.htaccess
!/public/assets/uploads/.gitkeep
/storage/app.key
/storage/tmp/*
!/storage/tmp/.htaccess
!/storage/tmp/.gitkeep
/storage/backups/*
!/storage/backups/.gitkeep
!/storage/backups/.htaccess
scripts/deploy.env
